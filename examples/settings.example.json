{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.claude/hooks/html-postcheck.mjs\"",
            "shell": "bash",
            "timeout": 30,
            "statusMessage": "check.mjsで構文確認中..."
          }
        ]
      }
    ]
  }
}
